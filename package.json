{
  "name": "derivationpath",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run && npm run test:legacy",
    "test:unit": "vitest run",
    "test:legacy": "node --import tsx test-key-alignment.ts && node --import tsx test-signature-validation.ts && node --import tsx test-transaction-signing.ts",
    "terms:md": "npx tsx scripts/terms-md.ts",
    "video:demo": "npx tsx video/demo.ts",
    "video:capture": "python3 video/capture.py",
    "video:check": "python3 video/render.py --check",
    "video:render": "python3 video/render.py",
    "video:subtitles": "python3 video/subtitles.py",
    "video:voice": "python3 video/speechify.py",
    "test:flows": "python3 video/capture.py --check"
  },
  "dependencies": {
    "@bsv/sdk": "^1.8.2",
    "@fontsource-variable/nunito": "^5.3.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@vercel/functions": "^3.9.9",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "agentation": "^3.1.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
